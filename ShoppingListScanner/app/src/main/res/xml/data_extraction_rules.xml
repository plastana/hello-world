<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive data from cloud backup -->
        <exclude domain="file" path="sensitive_data/" />
        <exclude domain="database" path="user_credentials.db" />
    </cloud-backup>
    
    <device-transfer>
        <!-- Include app data for device transfer -->
        <include domain="file" path="shopping_lists/" />
        <include domain="sharedpref" path="app_preferences.xml" />
    </device-transfer>
</data-extraction-rules>