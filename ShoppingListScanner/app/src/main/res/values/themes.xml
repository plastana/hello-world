<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ShoppingListScanner" parent="Theme.Material3.DayNight">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/primary_color</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent_color</item>
        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorSurface">@color/surface_color</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>
    </style>

    <style name="Theme.ShoppingListScanner" parent="Base.Theme.ShoppingListScanner" />
    
    <!-- Button styles -->
    <style name="AppButton" parent="Widget.Material3.Button">
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">8dp</item>
    </style>
    
    <style name="AppButton.Primary" parent="AppButton">
        <item name="backgroundTint">@color/primary_color</item>
        <item name="android:textColor">@color/white</item>
    </style>
    
    <style name="AppButton.Secondary" parent="AppButton">
        <item name="backgroundTint">@color/accent_color</item>
        <item name="android:textColor">@color/white</item>
    </style>
    
    <!-- Card styles -->
    <style name="AppCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
        <item name="android:layout_margin">8dp</item>
    </style>
    
    <!-- Text styles -->
    <style name="AppText" parent="Widget.Material3.TextView">
        <item name="android:textColor">@color/text_primary</item>
    </style>
    
    <style name="AppText.Title" parent="AppText">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    
    <style name="AppText.Subtitle" parent="AppText">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    
    <style name="AppText.Body" parent="AppText">
        <item name="android:textSize">14sp</item>
    </style>
    
    <style name="AppText.Caption" parent="AppText">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>